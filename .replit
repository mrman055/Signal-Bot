modules = ["nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["nano"]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[workflows]
runButton = "Start App"

[[workflows.workflow]]
name = "Start App"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && PORT=3001 pnpm run dev"
waitForPort = 3001

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/trading-bot && PORT=3000 BASE_PATH=/ pnpm run dev"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001
